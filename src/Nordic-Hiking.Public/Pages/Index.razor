@page "/"
@using NordicHiking.Public.Services
@inject HikeDataService HikeDataService
@inject IJSRuntime JS

<PageTitle>Vandringar i norden</PageTitle>

<div class="container-fluid p-0">
    <div class="row g-0">
        <div class="col-12">
            <div class="p-3 bg-light">
                <h1 class="text-center">🥾 Vandringar i norden 🎒</h1>
                <p class="text-center">Utforska vandringsleder från YouTube-kanaler</p>

                @if (isLoading)
                {
                    <div class="alert alert-info">
                        <span class="spinner-border spinner-border-sm"></span> Laddar platser...
                    </div>
                }
                else if (locations.Count == 0)
                {
                    <div class="alert alert-warning">
                        Inga platser hittades. Kontrollera att hikes.db finns i wwwroot/data/.
                    </div>
                }
                else
                {
                    @if (channels.Count > 0)
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <strong>🎬 Filtrera kanaler</strong>
                                    <span class="text-success ms-3">(@filteredLocations.Count av @locations.Count platser visas)</span>
                                </div>
                                <div>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="SelectAllChannels">Välj alla</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="DeselectAllChannels">Avmarkera alla</button>
                                </div>
                            </div>
                            <div class="card-body py-2">
                                <div class="d-flex flex-wrap gap-3">
                                    @foreach (var channel in channels)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="channel-@channel.Id" 
                                                   checked="@selectedChannelIds.Contains(channel.Id)"
                                                   @onchange="@(e => ToggleChannel(channel.Id, (bool)(e.Value ?? false)))" />
                                            <label class="form-check-label" for="channel-@channel.Id">
                                                @channel.Name
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <strong>🌤️ Filtrera säsong</strong>
                                </div>
                                <div>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="SelectAllSeasons">Välj alla</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="DeselectAllSeasons">Avmarkera alla</button>
                                </div>
                            </div>
                            <div class="card-body py-2">
                                <div class="d-flex flex-wrap gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="season-0" 
                                               checked="@selectedSeasons.Contains(0)"
                                               @onchange="@(e => ToggleSeason(0, (bool)(e.Value ?? false)))" />
                                        <label class="form-check-label" for="season-0">🌸 Vår</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="season-1" 
                                               checked="@selectedSeasons.Contains(1)"
                                               @onchange="@(e => ToggleSeason(1, (bool)(e.Value ?? false)))" />
                                        <label class="form-check-label" for="season-1">☀️ Sommar</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="season-2" 
                                               checked="@selectedSeasons.Contains(2)"
                                               @onchange="@(e => ToggleSeason(2, (bool)(e.Value ?? false)))" />
                                        <label class="form-check-label" for="season-2">🍂 Höst</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="season-3" 
                                               checked="@selectedSeasons.Contains(3)"
                                               @onchange="@(e => ToggleSeason(3, (bool)(e.Value ?? false)))" />
                                        <label class="form-check-label" for="season-3">❄️ Vinter</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="row g-0">
        <div class="col-12">
            <div id="map" style="height: 80vh; width: 100%;"></div>
        </div>
    </div>
</div>

@code {
    private List<HikeLocationDto> locations = new();
    private List<HikeLocationDto> filteredLocations = new();
    private List<ChannelDto> channels = new();
    private HashSet<int> selectedChannelIds = new();
    private HashSet<int> selectedSeasons = new() { 0, 1, 2, 3 }; // Alla säsonger valda som standard
    private bool isLoading = true;
    private bool mapInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
        }
    }

    private string ConvertMarkdownToHtml(string? markdown)
    {
        if (string.IsNullOrEmpty(markdown))
            return string.Empty;

        var html = markdown;
        
        // Konvertera rubriker (## -> h4, # -> h3)
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^### (.+)$", "<h5 style='margin-top: 10px; margin-bottom: 5px; color: #333;'>$1</h5>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^## (.+)$", "<h4 style='margin-top: 12px; margin-bottom: 6px; color: #222;'>$1</h4>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^# (.+)$", "<h3 style='margin-top: 15px; margin-bottom: 8px; color: #111;'>$1</h3>", System.Text.RegularExpressions.RegexOptions.Multiline);
        
        // Konvertera bold (**text**)
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        
        // Konvertera radbrytningar till <br/> för paragrafer
        html = html.Replace("\n\n", "</p><p style='margin: 8px 0; line-height: 1.5;'>");
        html = html.Replace("\n", "<br/>");
        
        // Wrappa i en paragraf
        html = $"<p style='margin: 8px 0; line-height: 1.5;'>{html}</p>";
        
        return html;
    }

    private string FormatDate(string? dateString)
    {
        if (string.IsNullOrEmpty(dateString))
            return "";
        
        if (DateTime.TryParse(dateString, out var date))
        {
            return date.ToString("yyyy-MM-dd");
        }
        
        return dateString;
    }

    private async Task LoadData()
    {
        try
        {
            locations = await HikeDataService.GetAllLocationsAsync();
            channels = await HikeDataService.GetAllChannelsAsync();
            
            // Välj alla kanaler som standard
            selectedChannelIds = new HashSet<int>(channels.Select(c => c.Id));

            if (locations.Count > 0)
            {
                // Initiera kartan centrerad på första platsen (Sverige som default)
                var firstLocation = locations.FirstOrDefault();
                var centerLat = firstLocation?.Latitude ?? 62.0;
                var centerLng = firstLocation?.Longitude ?? 15.0;

                await JS.InvokeVoidAsync("mapHelper.initializeMap", "map", centerLat, centerLng, 5);
                mapInitialized = true;

                await UpdateMapMarkers();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task UpdateMapMarkers()
    {
        if (!mapInitialized) return;

        // Rensa befintliga markers
        await JS.InvokeVoidAsync("mapHelper.clearMarkers");

        // Filtrera platser baserat på valda kanaler och säsonger
        filteredLocations = locations
            .Where(l => selectedChannelIds.Contains(l.ChannelId) && selectedSeasons.Contains(l.Season))
            .ToList();

        // Lägg till markers för filtrerade platser
        foreach (var location in filteredLocations)
        {
            var formattedSummary = ConvertMarkdownToHtml(location.VideoTalkSummary);
            
            var popupHtml = $@"
                <div style='min-width: 280px; max-width: 350px; max-height: 450px; overflow-y: auto;'>
                    <h5 style='margin-bottom: 8px;'>{location.PlaceName} <span style='font-size: 0.7em; font-weight: normal; color: #333;'>({FormatDate(location.PublishedAt)})</span></h5>
                    <p style='margin-bottom: 8px;'><strong>{location.Region}, {location.Country}</strong></p>
                    <img src='{location.VideoThumbnail}' style='width: 100%; max-width: 320px; border-radius: 4px;' /><br/>
                    <div style='margin: 10px 0;'>
                        <strong>Video:</strong> {location.VideoTitle}<br/>
                        <strong>Kanal:</strong> {location.ChannelName}<br/>
                        <strong>Svårighetsgrad:</strong> {location.Difficulty}<br/>
                        {(string.IsNullOrEmpty(location.Duration) ? "" : $"<strong>Längd:</strong> {location.Duration}<br/>")}
                    </div>
                    <p style='margin: 10px 0; font-size: 0.95em;'>{location.Summary}</p>
                    {(string.IsNullOrEmpty(location.VideoTalkSummary) ? "" : $@"
                    <details style='margin: 15px 0; background: #f8f9fa; border-radius: 6px; padding: 10px;'>
                        <summary style='cursor: pointer; font-weight: bold; color: #0d6efd;'>📖 Vad de pratar om i videon</summary>
                        <div style='margin-top: 10px; font-size: 0.9em; color: #333;'>{formattedSummary}</div>
                    </details>")}
                    <a href='{location.VideoUrl}' target='_blank' class='youtube-btn' style='margin-top: 10px;'>Se video på YouTube</a>
                </div>
            ";

            await JS.InvokeVoidAsync("mapHelper.addMarker", location.Latitude, location.Longitude, popupHtml);
        }

        // Anpassa kartan så alla markers syns
        if (filteredLocations.Count > 0)
        {
            await JS.InvokeVoidAsync("mapHelper.fitBounds");
        }
    }

    private async Task ToggleChannel(int channelId, bool isSelected)
    {
        if (isSelected)
        {
            selectedChannelIds.Add(channelId);
        }
        else
        {
            selectedChannelIds.Remove(channelId);
        }
        
        await UpdateMapMarkers();
        StateHasChanged();
    }

    private async Task SelectAllChannels()
    {
        selectedChannelIds = new HashSet<int>(channels.Select(c => c.Id));
        await UpdateMapMarkers();
        StateHasChanged();
    }

    private async Task DeselectAllChannels()
    {
        selectedChannelIds.Clear();
        await UpdateMapMarkers();
        StateHasChanged();
    }

    private async Task ToggleSeason(int season, bool isSelected)
    {
        if (isSelected)
        {
            selectedSeasons.Add(season);
        }
        else
        {
            selectedSeasons.Remove(season);
        }
        
        await UpdateMapMarkers();
        StateHasChanged();
    }

    private async Task SelectAllSeasons()
    {
        selectedSeasons = new HashSet<int> { 0, 1, 2, 3 };
        await UpdateMapMarkers();
        StateHasChanged();
    }

    private async Task DeselectAllSeasons()
    {
        selectedSeasons.Clear();
        await UpdateMapMarkers();
        StateHasChanged();
    }
}
