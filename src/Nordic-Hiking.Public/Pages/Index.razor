@page "/"
@using NordicHiking.Public.Services
@inject HikeDataService HikeDataService
@inject IJSRuntime JS

<PageTitle>Nordic Hiking — Vandringar i norden</PageTitle>

@if (isLoading)
{
    <div class="loading-container">
        <div class="loading-spinner"></div>
        <span>Laddar vandringar...</span>
    </div>
}
else if (locations.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon">🥾</div>
        <strong>Inga platser hittades</strong>
        <span>Kontrollera att hikes.db finns i wwwroot/data/</span>
    </div>
}
else
{
    <!-- Filter pills -->
    <div class="filter-bar">
        <button class="filter-pill @(selectedSeasons.Count == 4 ? "active" : "")" @onclick="ToggleAllSeasons">
            Alla
        </button>
        <button class="filter-pill @(IsSeasonActive(0) ? "active" : "")" @onclick="@(() => ToggleSeason(0))">
            🌸 Vår
        </button>
        <button class="filter-pill @(IsSeasonActive(1) ? "active" : "")" @onclick="@(() => ToggleSeason(1))">
            ☀️ Sommar
        </button>
        <button class="filter-pill @(IsSeasonActive(2) ? "active" : "")" @onclick="@(() => ToggleSeason(2))">
            🍂 Höst
        </button>
        <button class="filter-pill @(IsSeasonActive(3) ? "active" : "")" @onclick="@(() => ToggleSeason(3))">
            ❄️ Vinter
        </button>

        @if (channels.Count > 1)
        {
            <div class="filter-divider"></div>
            @foreach (var channel in channels)
            {
                <button class="filter-pill @(selectedChannelIds.Contains(channel.Id) ? "active" : "")"
                        @onclick="@(() => ToggleChannel(channel.Id))">
                    @channel.Name
                </button>
            }
        }
    </div>

    <!-- Split view: cards + map -->
    <div class="split-view">
        <div class="card-panel">
            <div class="panel-header">@filteredLocations.Count vandringar</div>
            @for (var i = 0; i < filteredLocations.Count; i++)
            {
                var index = i;
                var loc = filteredLocations[i];
                <div class="hike-card @(activeCardIndex == index ? "active" : "")"
                     @onclick="@(() => OnCardClick(index))">
                    <img class="hike-card-thumbnail" src="@loc.VideoThumbnail" alt="@loc.PlaceName" loading="lazy" />
                    <div class="hike-card-content">
                        <h3 class="hike-card-title">@loc.PlaceName</h3>
                        <p class="hike-card-location">@loc.Region, @loc.Country</p>
                        <div class="hike-card-meta">
                            <span class="hike-badge difficulty">@loc.Difficulty</span>
                            <span class="hike-badge season">@GetSeasonLabel(loc.Season)</span>
                        </div>
                        <p class="hike-card-channel">@loc.ChannelName</p>
                    </div>
                </div>
            }
        </div>
        <div class="map-panel">
            <div id="map"></div>
        </div>
    </div>
}

@code {
    private List<HikeLocationDto> locations = new();
    private List<HikeLocationDto> filteredLocations = new();
    private List<ChannelDto> channels = new();
    private HashSet<int> selectedChannelIds = new();
    private HashSet<int> selectedSeasons = new() { 0, 1, 2, 3 };
    private bool isLoading = true;
    private bool mapInitialized = false;
    private bool needsMapInit = false;
    private int activeCardIndex = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
        }
        else if (needsMapInit && !mapInitialized)
        {
            needsMapInit = false;
            await InitializeMap();
        }
    }

    private bool IsSeasonActive(int season)
    {
        // Active if this season is selected and not ALL are selected
        return selectedSeasons.Contains(season) && selectedSeasons.Count < 4;
    }

    private string GetSeasonLabel(int season) => season switch
    {
        0 => "Vår",
        1 => "Sommar",
        2 => "Höst",
        3 => "Vinter",
        _ => ""
    };

    private string ConvertMarkdownToHtml(string? markdown)
    {
        if (string.IsNullOrEmpty(markdown))
            return string.Empty;

        var html = markdown;
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^### (.+)$", "<h6 style='margin-top: 8px; margin-bottom: 4px; font-size: 0.85em;'>$1</h6>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^## (.+)$", "<h6 style='margin-top: 10px; margin-bottom: 5px; font-size: 0.9em;'>$1</h6>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^# (.+)$", "<h6 style='margin-top: 12px; margin-bottom: 6px; font-size: 0.95em;'>$1</h6>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        html = html.Replace("\n\n", "</p><p style='margin: 8px 0; line-height: 1.5;'>");
        html = html.Replace("\n", "<br/>");
        html = $"<p style='margin: 8px 0; line-height: 1.5;'>{html}</p>";
        return html;
    }

    private string FormatDate(string? dateString)
    {
        if (string.IsNullOrEmpty(dateString))
            return "";
        if (DateTime.TryParse(dateString, out var date))
            return date.ToString("yyyy-MM-dd");
        return dateString;
    }

    private async Task LoadData()
    {
        try
        {
            locations = await HikeDataService.GetAllLocationsAsync();
            channels = await HikeDataService.GetAllChannelsAsync();
            selectedChannelIds = new HashSet<int>(channels.Select(c => c.Id));
            filteredLocations = locations.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            needsMapInit = locations.Count > 0;
            StateHasChanged();
        }
    }

    private async Task InitializeMap()
    {
        try
        {
            var firstLocation = locations.FirstOrDefault();
            var centerLat = firstLocation?.Latitude ?? 62.0;
            var centerLng = firstLocation?.Longitude ?? 15.0;

            await JS.InvokeVoidAsync("mapHelper.initializeMap", "map", centerLat, centerLng, 5);
            mapInitialized = true;

            await UpdateMapMarkers();

            await JS.InvokeVoidAsync("eval", $"document.getElementById('location-count').textContent = '{locations.Count} vandringar'");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing map: {ex.Message}");
        }
    }

    private async Task UpdateMapMarkers()
    {
        if (!mapInitialized) return;

        await JS.InvokeVoidAsync("mapHelper.clearMarkers");

        filteredLocations = locations
            .Where(l => selectedChannelIds.Contains(l.ChannelId) && selectedSeasons.Contains(l.Season))
            .ToList();

        foreach (var location in filteredLocations)
        {
            var formattedSummary = ConvertMarkdownToHtml(location.VideoTalkSummary);

            var popupHtml = $@"
                <div class='popup-card'>
                    <img class='popup-thumbnail' src='{location.VideoThumbnail}' alt='{EscapeHtml(location.PlaceName)}' />
                    <div class='popup-card-body'>
                        <h5>{EscapeHtml(location.PlaceName)} <span class='popup-date'>{FormatDate(location.PublishedAt)}</span></h5>
                        <div class='popup-region'>{EscapeHtml(location.Region)}, {EscapeHtml(location.Country)}</div>
                        <div class='popup-details'>
                            <strong>Video:</strong> {EscapeHtml(location.VideoTitle)}<br/>
                            <strong>Kanal:</strong> {EscapeHtml(location.ChannelName)}<br/>
                            <strong>Svårighetsgrad:</strong> {EscapeHtml(location.Difficulty)}<br/>
                            {(string.IsNullOrEmpty(location.Duration) ? "" : $"<strong>Längd:</strong> {EscapeHtml(location.Duration)}<br/>")}
                        </div>
                        <div class='popup-summary'>{location.Summary}</div>
                        {(string.IsNullOrEmpty(location.VideoTalkSummary) ? "" : $@"
                        <details>
                            <summary>Vad de pratar om i videon</summary>
                            <div>{formattedSummary}</div>
                        </details>")}
                        <a href='{location.VideoUrl}' target='_blank' class='popup-youtube-btn'>▶ Se video på YouTube</a>
                    </div>
                </div>";

            await JS.InvokeVoidAsync("mapHelper.addMarker", location.Latitude, location.Longitude, popupHtml);
        }

        if (filteredLocations.Count > 0)
        {
            await JS.InvokeVoidAsync("mapHelper.fitBounds");
        }

        // Update header count
        await JS.InvokeVoidAsync("eval", $"document.getElementById('location-count').textContent = '{filteredLocations.Count} vandringar'");

        activeCardIndex = -1;
        StateHasChanged();
    }

    private string EscapeHtml(string? text)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;").Replace("'", "&#39;");
    }

    private async Task OnCardClick(int index)
    {
        activeCardIndex = index;
        await JS.InvokeVoidAsync("mapHelper.panToMarker", index);
    }

    private async Task ToggleSeason(int season)
    {
        if (selectedSeasons.Contains(season) && selectedSeasons.Count < 4)
        {
            // Already individually selected — deselect it
            selectedSeasons.Remove(season);
            if (selectedSeasons.Count == 0)
                selectedSeasons = new HashSet<int> { 0, 1, 2, 3 };
        }
        else
        {
            // Select only this season
            selectedSeasons = new HashSet<int> { season };
        }

        await UpdateMapMarkers();
    }

    private async Task ToggleAllSeasons()
    {
        selectedSeasons = new HashSet<int> { 0, 1, 2, 3 };
        await UpdateMapMarkers();
    }

    private async Task ToggleChannel(int channelId)
    {
        if (selectedChannelIds.Contains(channelId))
        {
            selectedChannelIds.Remove(channelId);
            if (selectedChannelIds.Count == 0)
                selectedChannelIds = new HashSet<int>(channels.Select(c => c.Id));
        }
        else
        {
            selectedChannelIds.Add(channelId);
        }

        await UpdateMapMarkers();
    }
}
